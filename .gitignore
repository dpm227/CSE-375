# Keep source code and build/run scripts; ignore documents, data, archives,
# editor settings, and generated executables (including extensionless ones).
*
!*/
!.gitignore
!*.c
!*.cc
!*.cpp
!*.cxx
!*.h
!*.hh
!*.hpp
!*.hxx
!*.tpp
!*.ipp
!*.py
!*.sh
!*.bash
!*.zsh
!Makefile
!makefile
!GNUmakefile
!CMakeLists.txt
!*.cmake

# Generated directories and extracted submission copies.
build/
Build/
build-*/
CMakeFiles/
.cache/
__pycache__/
vcpkg_installed/
Testing/
results/
pa1/dpm227/
